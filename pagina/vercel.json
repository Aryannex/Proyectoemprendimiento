{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "pagina": {
      "root": "pagina",
      "framework": "express"
    },
    "frontend": {
      "root": "pagina/frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}